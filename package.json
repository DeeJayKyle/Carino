{
  "name": "carino",
  "version": "1.7.1",
  "private": true,
  "description": "Carino — a personal AI assistant for Android that runs on your phone, with free AI services.",
  "type": "module",
  "scripts": {
    "dev": "vite -c vite.mobile.config.ts",
    "build": "vite build -c vite.mobile.config.ts",
    "build:desktop": "vite build -c vite.mobile.config.ts --outDir desktop/dist --emptyOutDir",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@jitl/quickjs-singlefile-mjs-release-sync": "^0.32.0",
    "@wllama/wllama": "^3.13.0",
    "chrono-node": "^2.10.3",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.0",
    "pptxgenjs": "^4.0.1",
    "qrcode-generator": "^2.0.4",
    "quickjs-emscripten-core": "^0.32.0",
    "unpdf": "^1.9.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "buffer": "^6.0.3",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "marked": "^18.1.1",
    "path-browserify": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "image-size": "^2.0.2",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
